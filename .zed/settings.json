// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "languages": {
    "TypeScript": {
      "inlay_hints": {
        "enabled": false
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": [
        "biome",
        "tsgo",
        "!vtsls",
        "!eslint",
        "!typescript-language-server",
        "oxfmt",
        "oxlint",
        "..."
      ]
    },
    "JSON": {
      "language_servers": ["json-language-server", "oxfmt", "oxlint"],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "language_servers": ["json-language-server", "oxfmt", "oxlint"],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "CSS": {
      "language_servers": ["!biome", "oxfmt", "oxlint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "HTML": {
      "language_servers": ["!biome", "oxfmt", "oxlint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  }
}
