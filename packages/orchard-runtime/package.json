{
  "name": "@orchard/runtime",
  "version": "0.1.0",
  "description": "Runtime/lifecycle helpers for Orchard (assembly, late attachment, event bridging)",
  "keywords": [
    "lifecycle",
    "notes",
    "orchard",
    "runtime"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bunup",
    "tc": "tsc --noEmit --pretty",
