{
  "name": "@orchard/runtime",
  "version": "0.1.0",
  "description": "Runtime/lifecycle helpers for Orchard (assembly, late attachment, event bridging)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm",
    "tc": "tsc --noEmit --pretty",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["orchard", "runtime", "notes", "lifecycle"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@tsconfig/bun": "^1.0.8",
    "@types/bun": "^1.2.23",
    "@typescript/native-preview": "^7.0.0-dev.20251004.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@orchard/core": "0.1.0",
    "tslib": "^2.8.0"
  }
}
