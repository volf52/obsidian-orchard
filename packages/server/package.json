{
  "name": "@orchard/server",
  "version": "1.0.0",
  "description": "Obsidian plugin with HTTP/2 server for Orchard",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "bun --bun run build.ts",
    "tc": "tsc --noEmit --pretty",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "keywords": ["obsidian", "plugin", "server", "http2"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "builtin-modules": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@scalar/hono-api-reference": "^0.9.22",
    "hono": "^4.10.1",
    "obsidian": "catalog:"
  }
}
