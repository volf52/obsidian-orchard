{
  "name": "@orchard/server",
  "version": "1.0.0",
  "description": "Obsidian plugin with HTTP/2 server for Orchard",
  "keywords": [
    "http2",
    "obsidian",
    "plugin",
    "server"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "bun --bun run build.ts",
    "tc": "tsc --noEmit --pretty",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@scalar/hono-api-reference": "^0.10.3",
    "hono": "catalog:",
    "obsidian": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "builtin-modules": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
