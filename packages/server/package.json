{
  "name": "@orchard/server",
  "version": "1.0.0",
  "description": "Obsidian plugin with HTTP/2 server for Orchard",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "bun --bun run build.ts",
    "tc": "tsc --noEmit --pretty",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "keywords": ["obsidian", "plugin", "server", "http2"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@tsconfig/bun": "^1.0.8",
    "@types/bun": "^1.2.23",
    "@typescript/native-preview": "^7.0.0-dev.20251004.1",
    "builtin-modules": "^5.0.0",
    "oxlint": "^1.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@scalar/hono-api-reference": "^0.9.20",
    "hono": "^4.9.9",
    "obsidian": "^1.10.0"
  }
}
