{
  "name": "@orchard/mcp-server",
  "version": "0.1.0",
  "description": "Obsidian plugin exposing Orchard core via MCP",
  "keywords": [
    "mcp",
    "obsidian",
    "orchard",
    "plugin"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "bun --bun run build.ts",
    "tc": "tsc --noEmit --pretty",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "test": "bun test src/mcp-server.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@orchard/core": "workspace:*",
    "hono": "catalog:",
    "obsidian": "catalog:",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "builtin-modules": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
