    "@typescript/native-preview": "^7.0.0-dev.20251004.1",
    "builtin-modules": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
      "obsidian": "^1.10.0",
      "hono": "^4.9.9",
      "@hono/node-server": "^1.19.5",
      "@modelcontextprotocol/sdk": "^1.1.0",
      "zod": "^3.23.8"
