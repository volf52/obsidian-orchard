{
  "name": "@orchard/mcp-server",
  "version": "0.1.0",
  "description": "Obsidian plugin exposing Orchard core via MCP",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "bun --bun run build.ts",
    "tc": "tsc --noEmit --pretty",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "test": "bun test src/mcp-server.test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": ["obsidian", "plugin", "mcp", "orchard"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "builtin-modules": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@orchard/core": "workspace:*",
    "obsidian": "catalog:",
    "hono": "^4.10.1",
    "@hono/node-server": "^1.19.5",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "zod": "^3.23.8"
  }
}
