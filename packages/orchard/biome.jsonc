{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "files": {
    "includes": [
      "src/**/*.{js,ts,json}",
      "./*test*.ts",
      ".oxlintrc.json",
      "package.json",
      "tsconfig.json",
      "biome.jsonc"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/*.svelte"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useConst": "off",
            "useImportType": "off"
          }
        }
      }
    }
  ],
  "extends": "//"
}
