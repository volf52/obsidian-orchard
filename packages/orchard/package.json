{
  "name": "@orchard/plugin",
  "version": "1.0.0",
  "description": "Obsidian Orchard plugin for video transcription and note management",
  "main": "index.js",
  "scripts": {
    "build": "bunup",
    "tc": "tsc --noEmit --pretty",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "biome check src",
    "lint:staged": "biome check --staged",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "check": "svelte-check --tsconfig tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["obsidian", "plugin", "video", "transcription"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@codemirror/state": "^6.5.2",
    "bunup": "catalog:",
    "@codemirror/view": "^6.38.6",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "builtin-modules": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "^4.3.3",
    "typescript": "catalog:",
    "@internal/build-plugins": "workspace:"
  },
  "dependencies": {
    "ky": "^1.12.0",
    "obsidian": "catalog:",
    "zustand": "^5.0.8"
  }
}
