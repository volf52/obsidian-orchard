{
  "name": "@orchard/plugin",
  "version": "1.0.0",
  "description": "Obsidian Orchard plugin for video transcription and note management",
  "main": "index.js",
  "scripts": {
    "build": "bun --bun run build.ts",
    "tc": "tsc --noEmit --pretty",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "biome check src",
    "lint:staged": "biome check --staged",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "check": "svelte-check --tsconfig tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["obsidian", "plugin", "video", "transcription"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.4",
    "@tsconfig/bun": "^1.0.8",
    "@types/bun": "^1.2.23",
    "@typescript/native-preview": "^7.0.0-dev.20251004.1",
    "builtin-modules": "^5.0.0",
    "oxlint": "^1.19.0",
    "svelte": "^5.39.8",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ky": "^1.11.0",
    "obsidian": "^1.10.0",
    "zustand": "^5.0.8"
  }
}
