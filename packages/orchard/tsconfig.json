{
  "$schema": "https://json.schemastore.org/tsconfig",
  "docs": "https://bun.sh/docs/typescript",
  "extends": "@tsconfig/bun",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "composite": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": false,
    "isolatedDeclarations": true,
    "declaration": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    // "checkJs": false,
    "plugins": [
      {
        "name": "typescript-svelte-plugin",
        // the following options can be set additionally; they are optional; their default values are listed here
        "enabled": true, // enables this plugin
        "assumeIsSvelteProject": true // if true, skip detection and always assume it's a Svelte project
      }
    ],
    "lib": ["DOM", "ES2022"],
    "paths": {
      "@/*": ["./src/*"],
      "@orchard/core": ["../orchard-core/src/index.ts"],
      "@internal/build-plugins": ["../../internal/build-plugins/src"],
      "@internal/build-plugins/*": ["../../internal/build-plugins/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "svelte-plugin.ts",
    "svelte-preload.ts"
  ],
  "exclude": ["node_modules", "dist", "version-bump.mjs"]
}
