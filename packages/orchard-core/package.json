{
  "name": "@orchard/core",
  "version": "0.1.0",
  "description": "Core domain layer for Orchard (notes, versions, events)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bunup",
    "tc": "tsc --noEmit --pretty",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["orchard", "obsidian", "core", "notes"],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bunup": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "tslib": "^2.8.0"
  }
}
