{
  "name": "@orchard/core",
  "version": "0.1.0",
  "description": "Core domain layer for Orchard (notes, versions, events)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm",
    "tc": "tsc --noEmit --pretty",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "fmt": "biome format src --write",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["orchard", "obsidian", "core", "notes"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@tsconfig/bun": "^1.0.8",
    "@types/bun": "^1.2.23",
    "@typescript/native-preview": "^7.0.0-dev.20251004.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tslib": "^2.8.0"
  }
}
