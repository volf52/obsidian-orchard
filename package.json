{
  "name": "obsidian-orchard-monorepo",
  "version": "1.0.0",
  "description": "My obsidian plugins for personal use",
  "engines": {
    "bun": ">=1.0.0"
  },
  "private": true,
  "scripts": {
    "build": "bun run --filter '*' build",
    "tc": "bun run --filter '*' tc",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "fmt": "bun run --filter '*' fmt",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "test:watch": "bun run --filter '*' test:watch",
    "clean": "bun run --filter '*' clean"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  },
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "@biomejs/biome": "^2.2.5",
      "@tsconfig/bun": "^1.0.8",
      "@types/bun": "^1.2.23",
      "@typescript/native-preview": "^7.0.0-dev.20251004.1",
      "oxlint": "^1.23.0",
      "builtin-modules": "^5.0.0",
      "obsidian": "^1.10.0",
      "typescript": "^5.9.3"
    }
  }
}
