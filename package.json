{
  "name": "obsidian-orchard-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "My obsidian plugins for personal use",
  "workspaces": {
    "packages": [
      "packages/*",
      "internal/*"
    ],
    "catalog": {
      "hono": "^4.12.7",
      "@hono/node-server": "^1.19.11",
      "@biomejs/biome": "^2.4.7",
      "bunup": "^0.16.31",
      "@tsconfig/bun": "^1.0.10",
      "@types/bun": "^1.3.10",
      "@typescript/native-preview": "^7.0.0-dev.20260313.1",
      "oxfmt": "^0.40.0",
      "oxlint": "^1.55.0",
      "oxlint-tsgolint": "^0.16.0",
      "builtin-modules": "^5.0.0",
      "obsidian": "^1.12.3",
      "typescript": "^5.9.3",
      "svelte": "^5.53.11"
    }
  },
  "scripts": {
    "build": "bunx bunup",
    "tc": "bun run --filter '*' tc",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "fmt": "bun run --filter '*' fmt",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "test:watch": "bun run --filter '*' test:watch",
    "clean": "bun run --filter '*' clean"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bunup": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
