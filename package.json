      "@hono/node-server": "^1.19.6",
      "@biomejs/biome": "^2.3.2",
      "bunup": "^0.15.13",
      "@tsconfig/bun": "^1.0.8",
      "@types/bun": "^1.3.1",
      "@typescript/native-preview": "^7.0.0-dev.20251101.1",
      "oxlint": "^1.25.0",
      "oxlint-tsgolint": "^0.4.0",
      "builtin-modules": "^5.0.0",
      "obsidian": "^1.10.2-1",
      "typescript": "^5.9.3",
      "svelte": "^5.43.2"
    }
